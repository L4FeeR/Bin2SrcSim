    {
      "cell_type": "code",
      "source": [
        "input_text = \"\"\"\n",
        "Convert assembly + pseudocode to C code:\n",
        "\n",
        "Assembly:\n",
        "mov eax, 10\n",
        "add eax, 5\n",
        "\n",
        "Pseudocode:\n",
        "int a = 10; a = a + 5;\n",
        "\n",
        "C Code:\n",
        "\"\"\"\n",
        "\n",
        "inputs = tokenizer(input_text, return_tensors=\"pt\").to(\"cuda\")\n",
        "\n",
        "outputs = model.generate(**inputs, max_new_tokens=100)\n",
        "\n",
        "print(tokenizer.decode(outputs[0], skip_special_tokens=True))"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "5dR8RLQGU6Tx",
        "outputId": "a0f077e1-5e88-4424-d5d8-383751b35bba"
      },
      "execution_count": 7,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "\n",
            "Convert assembly + pseudocode to C code:\n",
            "\n",
            "Assembly:\n",
            "mov eax, 10\n",
            "add eax, 5\n",
            "\n",
            "Pseudocode:\n",
            "int a = 10; a = a + 5;\n",
            "\n",
            "C Code:\n",
            "int main() {\n",
            "    int a;\n",
            "    a = 10;\n",
            "    a = a + 5;\n",
            "    return 0;\n",
            "}\n",
            "\n",
            "In this example, the assembly code adds 5 to the value of the variable `a` and stores the result in the variable `a`. The pseudocode translates this into C code that performs the same operation.\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "from sentence_transformers import SentenceTransformer, util\n",
        "\n",
        "embed_model = SentenceTransformer('all-MiniLM-L6-v2')\n",
        "\n",
        "code1 = \"int add(){ return 15; }\"\n",
        "code2 = \"int sum(){ return 10+5; }\"\n",
        "\n",
        "emb1 = embed_model.encode(code1, convert_to_tensor=True)\n",
        "emb2 = embed_model.encode(code2, convert_to_tensor=True)\n",
        "\n",
        "cos_sim = util.cos_sim(emb1, emb2)\n",
        "print(\"Cosine:\", cos_sim.item())"
      ],
