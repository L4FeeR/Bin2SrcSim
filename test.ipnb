    {
      "cell_type": "code",
      "source": [
        "def jaccard(a, b):\n",
        "    set1 = set(a.split())\n",
        "    set2 = set(b.split())\n",
        "    return len(set1 & set2) / len(set1 | set2)\n",
        "\n",
        "jac_sim = jaccard(code1, code2)\n",
        "print(\"Jaccard Similarity:\", jac_sim)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "drt0oMQPfr5p",
        "outputId": "11c2a669-263e-4877-c4ec-9a1be1122bfa"
      },
      "execution_count": 28,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Jaccard Similarity: 0.8130081300813008\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "final_score = 0.5 * ((cos_sim + 1)/2 + jac_sim)\n",
        "print(\"Final Similarity Score:\", final_score)"
      ],
