    {
      "cell_type": "code",
      "source": [
        "def format_example(example):\n",
        "    return {\n",
        "        \"text\": f\"\"\"Convert assembly + pseudocode to C code:\n",
        "\n",
        "Assembly:\n",
        "{example['asm']}\n",
        "\n",
        "Pseudocode:\n",
        "{example['pseudo']}\n",
        "\n",
        "C Code:\n",
        "{example['source']}\n",
        "\"\"\"\n",
        "    }\n",
        "\n",
        "dataset = dataset.map(format_example)"
      ],
