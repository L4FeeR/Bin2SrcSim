    {
      "cell_type": "code",
      "source": [
        "def generate_code(asm, pseudo):\n",
        "    input_text = f\"\"\"\n",
        "Convert assembly + pseudocode to C code:\n",
        "\n",
        "Assembly:\n",
        "{asm[:500]}\n",
        "\n",
        "Pseudocode:\n",
        "{pseudo[:500]}\n",
        "\n",
        "C Code:\n",
        "\"\"\"\n",
        "    inputs = tokenizer(input_text, return_tensors=\"pt\").to(\"cuda\")\n",
        "    outputs = model.generate(**inputs, max_new_tokens=200)\n",
        "    return tokenizer.decode(outputs[0], skip_special_tokens=True)\n",
        "\n",
        "code1 = generate_code(asm1, pseudo1)\n",
        "code2 = generate_code(asm2, pseudo2)\n",
        "\n",
        "print(\"Code1:\\n\", code1)\n",
        "print(\"\\nCode2:\\n\", code2)"
      ],
