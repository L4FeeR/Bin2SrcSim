    {
      "cell_type": "code",
      "source": [
        "from datasets import Dataset\n",
        "\n",
        "data = [\n",
        "    {\n",
        "        \"asm\": \"mov eax, 1\\nadd eax, 2\",\n",
        "        \"pseudo\": \"int a = 1; a = a + 2;\",\n",
        "        \"source\": \"int add(){ int a=1; return a+2; }\"\n",
        "    },\n",
        "    {\n",
        "        \"asm\": \"mov eax, 5\\nsub eax, 3\",\n",
        "        \"pseudo\": \"int a = 5; a = a - 3;\",\n",
        "        \"source\": \"int sub(){ int a=5; return a-3; }\"\n",
        "    }\n",
        "]\n",
        "\n",
        "dataset = Dataset.from_list(data)\n",
        "dataset"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "u5TEwK1qUA5v",
