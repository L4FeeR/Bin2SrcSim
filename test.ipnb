    {
      "cell_type": "code",
      "source": [
        "# 🔧 Tokenization + Labels (FIXED)\n",
        "\n",
        "def tokenize(example):\n",
        "    tokens = tokenizer(\n",
        "        example[\"text\"],\n",
        "        truncation=True,\n",
        "        padding=\"max_length\",\n",
        "        max_length=512\n",
        "    )\n",
        "    tokens[\"labels\"] = tokens[\"input_ids\"].copy()  # ✅ Required for training\n",
        "    return tokens\n",
        "\n",
        "tokenized = dataset.map(tokenize)\n",
        "\n",
        "# Remove unused columns (IMPORTANT)\n",
        "tokenized = tokenized.remove_columns(dataset.column_names)\n",
        "\n",
        "\n",
        "# 🚀 Training Setup\n",
        "\n",
        "from transformers import TrainingArguments, Trainer\n",
        "\n",
        "training_args = TrainingArguments(\n",
        "    output_dir=\"./bin2src\",\n",
        "    per_device_train_batch_size=2,\n",
        "    num_train_epochs=3,\n",
        "    logging_steps=1,\n",
        "    save_strategy=\"no\",\n",
        "    report_to=\"none\"  # avoids wandb issues\n",
        ")\n",
        "\n",
        "\n",
        "# 🧠 Trainer\n",
        "\n",
        "trainer = Trainer(\n",
        "    model=model,\n",
        "    args=training_args,\n",
        "    train_dataset=tokenized\n",
        ")\n",
        "\n",
        "\n",
        "# 🏋️ Start Training\n",
        "\n",
        "trainer.train()"
      ],
      "metadata": {
