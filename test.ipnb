        "# First binary\n",
        "asm1 = open(\"test_binary.dsm\").read()\n",
        "pseudo1 = open(\"test_binary.c\").read()\n",
        "\n",
        "# Second binary\n",
        "asm2 = open(\"test2_binary.dsm\").read()\n",
        "pseudo2 = open(\"test2_binary.c\").read()"
      ],
