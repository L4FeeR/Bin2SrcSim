    {
      "cell_type": "code",
      "source": [
        "def jaccard(a, b):\n",
        "    set1 = set(a.split())\n",
        "    set2 = set(b.split())\n",
        "    return len(set1 & set2) / len(set1 | set2)\n",
        "\n",
        "print(\"Jaccard:\", jaccard(code1, code2))"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "EPmCEB2tcg1e",
        "outputId": "35f9c738-2208-49da-b5ac-f8dd9d501882"
      },
      "execution_count": 9,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Jaccard: 0.42857142857142855\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "score = 0.5 * ((cos_sim.item() + 1)/2 + jaccard(code1, code2))\n",
        "print(\"Final Score:\", score)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
